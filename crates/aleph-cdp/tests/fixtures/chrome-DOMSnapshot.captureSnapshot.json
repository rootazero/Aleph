    "\n    window.__clicks = [];\n    document.getElementById('deep-target').addEventListener('click', function (e) {\n      window.__clicks.push({ id: 'deep-target', clientX: e.clientX, clientY: e.clientY,\n                             pageX: e.pageX, pageY: e.pageY, scrollY: window.scrollY });\n    });\n    document.getElementById('go').addEventListener('click', function () {\n      window.__clicks.push({ id: 'go' });\n    });\n    // Effect flags. A CDP method that answers `{}` while doing nothing is indistinguishable from\n    // one that worked, unless the page itself reports what reached it. These are the read-back.\n    window.__aleph_touch = false;\n    window.__aleph_drag = false;\n    document.addEventListener('touchstart', function () { window.__aleph_touch = true; }, true);\n    document.addEventListener('dragover', function () { window.__aleph_drag = true; }, true);\n    document.addEventListener('drop', function () { window.__aleph_drag = true; }, true);\n    var child = new URL(location.href).searchParams.get('child');\n    if (child) { document.getElementById('frame-host').src = child; }\n  ",
