{
  "mcpServers": {
    "veimagex": {
      "command": "uvx",
      "args": ["veimagex-mcp"],
      "env": {
        "VOLCENGINE_ACCESS_KEY": "<YOUR_VOLCENGINE_ACCESS_KEY>",
        "VOLCENGINE_SECRET_KEY": "<YOUR_VOLCENGINE_SECRET_KEY>",
        "SERVICE_ID": "<YOUR_IMAGEX_SERVICE_ID>",
        "DOMAIN": "<YOUR_IMAGEX_DOMAIN>"
      }
    }
  }
}
