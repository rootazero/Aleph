{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aleph Panel",
  "identifier": "ai.aleph.panel",
  "mainBinaryName": "aleph-panel-shell",
  "bundle": {
    "externalBin": [],
    "icon": [
      "icons/panel/32x32.png",
      "icons/panel/128x128.png",
      "icons/panel/128x128@2x.png",
      "icons/panel/icon.icns",
      "icons/panel/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/panel/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rootazero/Aleph/releases/latest/download/latest-panel.json"
      ]
    }
  }
}
