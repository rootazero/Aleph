{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aleph",
  "mainBinaryName": "Aleph",
  "identifier": "ai.aleph.desktop",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/aleph-server"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Your resident AI assistant",
    "longDescription": "Aleph desktop shell — a native window, system tray, and lifecycle host for the Aleph Panel, backed by the local aleph-server daemon.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5RDdGMTkxREREM0RFQ0EKUldUSzN0UGRrZkhYMmQ0S0c5cDB3UEtGWVo1R05IZExyVlB6R3NXdDJkbnpGdlpYUWp4ejdMcU8K",
      "endpoints": [
        "https://github.com/rootazero/Aleph/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["aleph"]
      }
    }
  }
}
