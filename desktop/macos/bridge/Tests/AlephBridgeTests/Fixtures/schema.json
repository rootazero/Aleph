  "Request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "JSON-RPC 2.0 request with u64 id (replaces old String-based id).",
    "properties": {
      "id": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "jsonrpc": {
        "type": "string"
