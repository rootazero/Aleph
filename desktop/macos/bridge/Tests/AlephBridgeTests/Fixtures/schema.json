            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "height",
          "width",
          "x",
          "y"
        ],
        "type": "object"
      }
    },
    "properties": {
      "display_id": {
        "format": "uint32",
        "minimum": 0.0,
        "type": [
          "integer",
          "null"
