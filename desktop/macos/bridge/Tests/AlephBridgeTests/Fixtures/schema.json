{
  "AudioDeviceInfo": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "is_default": {
        "description": "Whether this is the current default input device.",
        "type": "boolean"
      },
      "is_input": {
        "description": "Whether this is an input device.",
        "type": "boolean"
      },
      "name": {
        "description": "Human-readable device name.",
        "type": "string"
      },
      "uid": {
        "description": "Unique device identifier (`CoreAudio` UID).",
        "type": "string"
      }
    },
    "required": [
      "uid",
      "name",
      "is_input",
      "is_default"
    ],
    "title": "AudioDeviceInfo",
    "type": "object"
  },
  "CaptureParams": {
    "$defs": {
      "Region": {
        "properties": {
          "height": {
            "format": "double",
            "type": "number"
          },
          "width": {
            "format": "double",
            "type": "number"
          },
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "display_id": {
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "region": {
        "anyOf": [
          {
            "$ref": "#/$defs/Region"
          },
          {
            "type": "null"
          }
        ]
      },
      "show_cursor": {
        "description": "Draw the mouse cursor into the capture. Absent ⇒ platform default.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "window_id": {
        "description": "Capture just this window (id from `window.list`), cropped to its frame,\ninstead of a whole display. The window does not need to be frontmost.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "title": "CaptureParams",
    "type": "object"
  },
  "CaptureResult": {
    "$defs": {
      "Region": {
        "properties": {
          "height": {
            "format": "double",
            "type": "number"
          },
          "width": {
            "format": "double",
            "type": "number"
          },
          "x": {
            "format": "double",
            "type": "number"
          },
          "y": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "height": {
        "description": "Image height in PIXELS (`height_points * scale`).",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "png_base64": {
        "type": "string"
      },
      "scale": {
        "description": "Backing scale of the captured surface (2.0 on Retina): `pixels = points * scale`.",
        "format": "double",
        "type": [
          "number",
          "null"
        ]
      },
      "width": {
        "description": "Image width in PIXELS (`width_points * scale`).",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "window_bounds": {
        "anyOf": [
          {
            "$ref": "#/$defs/Region"
          },
          {
            "type": "null"
          }
        ],
        "description": "Origin+size of the captured surface in the GLOBAL screen POINT space,\ntop-left origin — i.e. the same space clicks are issued in.\n\nLOAD-BEARING for `window_id` captures: without it the crop's pixels\ncannot be mapped back to global click coordinates\n(`global = window_bounds.origin + pixel / scale`), and a window-cropped\nscreenshot silently becomes a targeting regression. Absent on a\nfull-display capture, and absent from a helper that predates the field."
      }
    },
    "required": [
      "png_base64",
      "width",
      "height"
    ],
    "title": "CaptureResult",
    "type": "object"
  },
  "ClickParams": {
    "$defs": {
      "MouseButton": {
        "enum": [
          "left",
          "right",
          "middle"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Params for `input.click` **and** `input.double_click`.\n\n`input.double_click` ignores `click_count` and always delivers a native\ndouble-click (click count 2).",
    "properties": {
      "button": {
        "$ref": "#/$defs/MouseButton"
      },
      "click_count": {
        "description": "Native click count carried on the event itself. Absent or `1` is a\nsingle click; `2` is a real double-click. Two independent single clicks\nare NOT a double-click — the app reads the click count off the event, so\nit must be set on the event rather than synthesized by clicking twice.",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "pid": {
        "description": "Target process for the targeted rail; absent ⇒ global HID tap.",
        "format": "int32",
        "type": [
          "integer",
          "null"
        ]
      },
      "x": {
        "format": "double",
        "type": "number"
      },
      "y": {
        "format": "double",
        "type": "number"
      }
    },
    "required": [
      "x",
      "y",
      "button"
    ],
    "title": "ClickParams",
    "type": "object"
  },
  "ClickResult": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "delivery": {
        "default": "global",
        "description": "Which rail actually delivered the event: [`DELIVERY_TARGETED`] or\n[`DELIVERY_GLOBAL`].",
        "type": "string"
      },
      "ok": {
        "type": "boolean"
      }
    },
    "required": [
      "ok"
    ],
    "title": "ClickResult",
    "type": "object"
  },
  "ClipParams": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "duration_secs": {
        "description": "Duration in seconds. Caller clamps to [0.25, 60.0].",
        "format": "double",
        "type": "number"
      },
      "with_audio": {
        "description": "Mix microphone audio into the clip.",
        "type": "boolean"
      }
    },
    "required": [
      "duration_secs",
      "with_audio"
    ],
    "title": "ClipParams",
    "type": "object"
  },
  "ClipResult": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "duration_secs": {
        "format": "double",
        "type": "number"
      },
      "file_path": {
        "description": "Absolute path to the recorded MP4/MOV.",
        "type": "string"
      },
      "has_audio": {
        "type": "boolean"
      }
    },
    "required": [
      "file_path",
      "duration_secs",
      "has_audio"
    ],
    "title": "ClipResult",
    "type": "object"
  },
  "CursorPositionResult": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "x": {
        "format": "double",
        "type": "number"
      },
      "y": {
        "format": "double",
        "type": "number"
      }
    },
    "required": [
      "x",
      "y"
    ],
    "title": "CursorPositionResult",
    "type": "object"
  },
  "DragParams": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "duration_ms": {
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "end_x": {
        "format": "double",
        "type": "number"
      },
      "end_y": {
        "format": "double",
        "type": "number"
      },
      "pid": {
        "description": "Target process for the targeted rail; absent ⇒ global HID tap.",
        "format": "int32",
        "type": [
          "integer",
          "null"
        ]
      },
      "start_x": {
        "format": "double",
        "type": "number"
      },
      "start_y": {
        "format": "double",
        "type": "number"
      }
    },
    "required": [
      "start_x",
      "start_y",
      "end_x",
      "end_y"
    ],
    "title": "DragParams",
    "type": "object"
  },
  "DragResult": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "delivery": {
        "default": "global",
        "type": "string"
      },
      "ok": {
        "type": "boolean"
      }
    },
    "required": [
      "ok"
    ],
    "title": "DragResult",
    "type": "object"
  },
  "ErrorResponse": {
    "$defs": {
      "RpcError": {
        "properties": {
          "code": {
            "format": "int32",
            "type": "integer"
          },
          "data": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "error": {
        "$ref": "#/$defs/RpcError"
      },
      "id": {
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "jsonrpc": {
        "type": "string"
      }
    },
    "required": [
      "jsonrpc",
      "error"
    ],
    "title": "ErrorResponse",
    "type": "object"
  },
