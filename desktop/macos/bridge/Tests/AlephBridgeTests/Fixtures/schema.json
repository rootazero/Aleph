      },
      "is_input": {
        "description": "Whether this is an input device.",
        "type": "boolean"
      },
      "name": {
        "description": "Human-readable device name.",
        "type": "string"
      },
      "uid": {
        "description": "Unique device identifier (CoreAudio UID).",
        "type": "string"
      }
    },
    "required": [
      "is_default",
      "is_input",
      "name",
      "uid"
    ],
    "title": "AudioDeviceInfo",
    "type": "object"
  },
  "CaptureParams": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "Region": {
        "properties": {
          "height": {
            "format": "double",
