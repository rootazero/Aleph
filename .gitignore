# Generated tooling output (analysis / scratch dirs)
# ==============================================================================
graphify-out/
**/graphify-out/
.understand-anything/
.codegraph/
.superpowers/
.omc/
# Agent-tool worktree / review scratch dirs (stray source copies + run reports)
.claire/
.context/
# Raw audit dumps from agent review runs (large machine-generated JSON;
# curated summaries belong in review-results/, which IS tracked)
.review/
# Pi coding-agent session/task state (per-machine, regenerated on each run)
.pi/
# Local third-party reference source cache
.ref-cache/
# rust-doctor per-crate diagnostic cache (regenerated on each scan)
.rust-doctor-cache.json
**/.rust-doctor-cache.json
# rust-doctor scratch revert list
/revert_list.txt

# ==============================================================================
# Git worktrees
# ==============================================================================
.worktrees/

# ==============================================================================
# AI agent scaffolding
# ==============================================================================
# Root .agent/ and .claude/ are shared with the team; nested copies
# (in worktrees / subdirs) stay local.
**/.claude/
!/.claude/
# Root .claude/ is shared except these local-only bits:
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/worktrees/
# opencode CLI local config (per-machine, references project plugins)
/.opencode/
# Pi agent local state (per-machine, runtime task persistence)
/.pi/

# ==============================================================================
# Project scratch & misc
# ==============================================================================
core/test.txt
newinstall*.txt
.test-out.txt
test-results/
playwright-report/
agentstructure/
archive/
_bmad/

# Examples — track curated subdirs only
examples/*
!examples/plugins/
!examples/protocols/
!examples/protocols/**

# Audit prompts (used for parallel subagent reviews)
.audit-prompt-batch*.md
__pycache__/
*.pyc

# Local backup scratch folder
backup/

# Third-party reference clones (independent git repos, not part of Aleph)
pi-subagents/
pi-tasks/
