# ==============================================================================
# Secrets — NEVER commit (release signing private key, password, credentials)
# ==============================================================================
# Anchored to the repo root on purpose. An unanchored `secrets/` also matches
# `src/secrets/` (the secrets *subsystem* source), which made every new file
# there invisible to `git add .` and made `rg` skip the whole module — so a
# repo-wide grep for a consumer inside `src/secrets/` silently returned zero.
/secrets/

# ==============================================================================
# Languages & build systems
# ==============================================================================

# Rust
/target/
**/target/
**/*.rs.bk
*.pdb
*.rlib
*.so
*.a
# Git worktrees (per-project isolation; never commit the tree)
/.worktrees/
# Per-machine local cargo settings (e.g. a shared absolute target-dir for
# parallel worktree builds). Machine-specific — must never be committed, or it
# breaks CI runners that lack the hardcoded path.
.cargo/config.toml

# Swift Package Manager
.build/
.swiftpm/

# Node.js
node_modules/

