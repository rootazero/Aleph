# ==============================================================================
# Secrets — NEVER commit (release signing private key, password, credentials)
# ==============================================================================
secrets/

# ==============================================================================
# Languages & build systems
# ==============================================================================

# Rust
/target/
**/target/
**/*.rs.bk
*.pdb
*.rlib
*.so
*.a
# Per-machine local cargo settings (e.g. a shared absolute target-dir for
# parallel worktree builds). Machine-specific — must never be committed, or it
# breaks CI runners that lack the hardcoded path.
.cargo/config.toml

# Swift Package Manager
.build/
.swiftpm/

# Node.js
node_modules/

# ==============================================================================
# Editors & OS
# ==============================================================================

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Xcode (generated by XcodeGen)
*.xcodeproj
!*.xcodeproj/project.xcworkspace/xcshareddata/
!*.xcodeproj/xcshareddata/
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata
*.xcuserdata
xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xcodeproj.backup

# ==============================================================================
# Build & runtime artifacts
# ==============================================================================

# Database files
*.db
*.db-shm
*.db-wal

# Platform build artifacts (legacy paths)
platforms/macos/Aleph/Frameworks/*.dylib
platforms/macos/Aleph/Frameworks/*.dylib.*

# Build pipeline logs (root-level scratch logs from just shell-build / wasm retry)
/.shell-build.log
/.wasm-retry.log

# Packaged installers
Aleph.dmg

# ==============================================================================
# Generated tooling output (analysis / scratch dirs)
# ==============================================================================
graphify-out/
**/graphify-out/
.understand-anything/
.codegraph/
.superpowers/
.omc/
# Agent-tool worktree / review scratch dirs (stray source copies + run reports)
.claire/
.context/
# rust-doctor per-crate diagnostic cache (regenerated on each scan)
.rust-doctor-cache.json
**/.rust-doctor-cache.json
# rust-doctor scratch revert list
/revert_list.txt

# ==============================================================================
# Git worktrees
# ==============================================================================
.worktrees/

# ==============================================================================
# AI agent scaffolding
# ==============================================================================
# Root .agent/ and .claude/ are shared with the team; nested copies
# (in worktrees / subdirs) stay local.
**/.claude/
!/.claude/
# Root .claude/ is shared except these local-only bits:
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/worktrees/
# opencode CLI local config (per-machine, references project plugins)
/.opencode/

# ==============================================================================
# Project scratch & misc
# ==============================================================================
core/test.txt
newinstall*.txt
.test-out.txt
test-results/
playwright-report/
agentstructure/
archive/
_bmad/

# Examples — track curated subdirs only
examples/*
!examples/plugins/
!examples/protocols/
!examples/protocols/**
