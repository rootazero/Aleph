# Rust
/target/
**/target/
# Per-machine local cargo settings (e.g. a shared absolute target-dir for
# parallel worktree builds). Machine-specific — must never be committed, or it
# breaks CI runners that lack the hardcoded path.
.cargo/config.toml
**/*.rs.bk
*.pdb
*.rlib
*.so
*.a

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Xcode (generated by XcodeGen)
*.xcodeproj
!*.xcodeproj/project.xcworkspace/xcshareddata/
!*.xcodeproj/xcshareddata/
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata
*.xcuserdata
xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xcodeproj.backup

# Swift Package Manager
.build/
.swiftpm/

# Node.js
node_modules/

# Database files
*.db
*.db-shm
*.db-wal

# Platform build artifacts (legacy paths)
platforms/macos/Aleph/Frameworks/*.dylib
platforms/macos/Aleph/Frameworks/*.dylib.*

# AI agent scaffolding — root .agent/ and .claude/ are shared with the team.
# Nested copies (in worktrees/subdirs) stay local.
**/.claude/
!/.claude/
# Root .claude/ is shared except these local-only bits:
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/worktrees/

# Git worktrees
.worktrees/

# Docs
_bmad/

# Test / scratch / local files
core/test.txt
newinstall*.txt
test-results/
playwright-report/

# Build pipeline artifacts
apps/macos-native/Aleph/Resources/aleph
apps/macos-native/build/

# Misc
agentstructure/
Aleph.dmg
examples/*
!examples/plugins/
!examples/protocols/
!examples/protocols/**

# UI node artifacts
archive/
graphify-out/
**/graphify-out/
.superpowers/
.omc/
.worktrees/
.understand-anything/
.codegraph/

# Docs: untrack everything except the README-referenced reference/ docs and
# the guides/ directory — docs/guides/*.md are compile-time build assets
# (src/config embeds them via include_str!), so they must stay tracked.
# Engineering artifacts (audit / logic-review reports, result dumps) are moved
# under docs/engineering-reports/ and stay untracked.
/docs/*
!/docs/reference/
!/docs/guides/
