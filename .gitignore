# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Xcode (generated by XcodeGen)
*.xcodeproj
!*.xcodeproj/project.xcworkspace/xcshareddata/
!*.xcodeproj/xcshareddata/
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata
*.xcuserdata
xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xcodeproj.backup

