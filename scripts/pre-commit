#!/usr/bin/env bash
# Git pre-commit hook: run cargo fmt + clippy on the workspace.
#
# Installed by scripts/install-hooks.sh into .git/hooks/pre-commit.
# Bypass: git commit --no-verify
#
# Same checks the GitHub Actions workflow runs at
# .github/workflows/aleph-core-ci.yml:349,351 — same scope, same crates.

set -euo pipefail

echo "==> cargo fmt --check (alephcore, cdp, desktop)"
cargo fmt -p alephcore -p aleph-cdp \
    -p aleph-desktop -p aleph-desktop-macos \
    -p aleph-desktop-linux -p aleph-desktop-windows \
    -- --check

echo "==> cargo clippy --all-targets (alephcore)"
# `-A dead_code -A unused_imports` lets the hook pass on the ~11 pre-existing
# warnings in origin/main code (dead_code on unused methods, unused_imports
# in test files). New regressions in those categories still surface as
# errors; the lint categories we actually care about (correctness, perf,
# API misuse) keep their default warn→error promotion.
cargo clippy -p alephcore --all-targets -- \
    -D warnings -A dead_code -A unused_imports

echo "==> pre-commit checks passed"