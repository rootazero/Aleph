+#[tokio::test]
+async fn lag_close_target_is_suppressed_when_a_fresh_fetch_slot_is_registered() {
+    // Task 3: the lifecycle lock around `spawn_close_target` and
+    // `register_fetch` must order re-arm over stale close.
+    let (server, owner, _handle) = fixture().await;
+    server.on(
+        "Target.closeTarget",
+        Responder::Reply(json!({"success": true})),
+    );
+    // The simulated fail-closed takes the lifecycle lock, drains fetch,
+    // then queues a close. We register a fresh feed AFTER the close task
+    // is spawned (post drain) but BEFORE it can acquire the lock: the
+    // close must see the new slot and skip.
+    //
+    // We force the close task to wait by acquiring the lifecycle lock on
+    // a different awaitable first; the re-arm goes through; then we release
+    // and let the close task run.
+    let _gate = owner.lifecycle.lock().await;
+    // Spawn the close task under the gate so it queues on the lock.
+    let target = "T1".to_string();
+    owner
+        .spawn_close_target_for_test(target.clone())
+        .await;
+    // Re-arm while the close task is queued on the lock.
+    let _rearmed = owner
+        .register_fetch(&target, &SessionId("S1".into()))
+        .await;
+    drop(_gate);
+    // Give the close task time to acquire the lock, see the slot, and skip.
+    tokio::time::sleep(Duration::from_millis(200)).await;
+    assert!(
+        server.received_for("Target.closeTarget").is_empty(),
+        "a close that lost the lifecycle race against a register_fetch must NOT be sent"
+    );
+}
