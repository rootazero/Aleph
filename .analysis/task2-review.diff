+#[tokio::test]
+async fn target_destroyed_does_not_stop_a_re_armed_screencast_for_the_same_target() {
+    // The fail-closed cleanup is target-aware: if a new stream has re-armed
+    // for the target in the meantime, the stop is suppressed.
+    let (server, owner, _handle) = fixture().await;
+    owner.attach_target(binding("T1")).await.unwrap();
+    // Simulate a re-arm landing between drain and stop: insert a stream
+    // entry directly so `spawn_stop_if_unowned` sees one and skips.
+    {
+        let mut st = owner.state();
+        st.streams.insert(
+            "T1".to_string(),
+            super::session::TargetStream::new(
+                owner.state().next_epoch,
+                SessionId("S1".to_string()),
+            ),
+        );
+    }
+    owner.dispatch(&Arc::new(aleph_cdp::CdpEvent {
+        session: None,
+        method: "Target.targetDestroyed".into(),
+        params: json!({"targetId": "T1"}),
+    }));
+    // Give the spawned stop task a chance to mis-fire; the assertion is that
+    // it does NOT.
+    tokio::time::sleep(Duration::from_millis(150)).await;
+    assert!(
+        server.received_for("Page.stopScreencast").is_empty(),
+        "a re-armed stream for the same target must not be torn down by a stale stop"
+    );
+}
