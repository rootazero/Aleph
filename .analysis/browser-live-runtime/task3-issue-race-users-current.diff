+    #[test]
+    fn viewer_issue_without_live_user_authority_denies() {
+        use crate::browser::live::issuer::tests::{fixture, request, USER};
+        use aleph_protocol::browser_live::ViewerPermission;
+        for users in [None, Some(seeded_store())] {
