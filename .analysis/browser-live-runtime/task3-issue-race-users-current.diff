+    /// Pause the real dispatch path after its live identity revalidation but
+    /// before the production issue handler inserts. No sleep or policy bypass.
+    #[tokio::test]
+    async fn deactivation_between_dispatch_validation_and_grant_insert_denies() {
+        use crate::browser::live::issuer::tests::{fixture, request, USER};
+        use crate::gateway::middleware::MiddlewareChain;
+        use crate::gateway::rate_limiter::RateLimiter;
+        use crate::gateway::server::connection::{dispatch_for_connection, CallerSnapshot};
+        use aleph_protocol::browser_live::{IssuerIdentity, ViewerPermission};
+        use std::time::Duration;
+
+        #[derive(Default)]
+        struct TestHooks {
+            entered: tokio::sync::Notify,
+            release: tokio::sync::Notify,
+        }
+        let store = seeded_store();
+        store.create_user(USER, "Viewer", UserRole::Member).unwrap();
+        upsert_panel_device(&store, "race-device", USER);
+        let kick = test_kick_sink();
+        let f = fixture(Duration::from_secs(600));
+        kick.browser_viewer_grants
+            .bind(f.grants.clone(), Some(store.clone()));
+        let principal = IssuerIdentity::User {
+            user_id: USER.into(),
+        };
+        let req = || request(&f.resource, vec![ViewerPermission::Frames]);
+        let earlier = f.state.issue(USER, req()).expect("active user can issue");
+        let mut connection = ConnectionState::new([203, 0, 113, 7].into(), false);
+        connection.caller_role = "member".into();
+        connection.caller_user = Some(USER.into());
+        connection.verified_user = Some(USER.into());
+        connection.device_id = Some("race-device".into());
+        kick.connections
+            .write()
+            .await
+            .insert("race-conn".into(), connection);
+        let start = CallerSnapshot::read(&kick.connections, "race-conn", false).await;
+        let hooks = Arc::new(TestHooks::default());
+        let mut handlers = super::super::HandlerRegistry::new();
+        let pause = hooks.clone();
+        let issuer = f.state.clone();
+        handlers.register("browser.viewer.grant.issue", move |request| {
+            let pause = pause.clone();
+            let issuer = issuer.clone();
+            async move {
+                assert_eq!(
+                    crate::gateway::caller_identity::current_caller_verified_user().as_deref(),
+                    Some(USER),
+                    "the real dispatch must have passed revalidation"
+                );
+                pause.entered.notify_one();
+                pause.release.notified().await;
+                super::super::browser_viewer::handle_issue(request, Some(issuer)).await
+            }
+        });
+        let chain = MiddlewareChain::new(
+            Arc::new(handlers),
+            Arc::new(RateLimiter::new(Default::default())),
+        );
+        let text = serde_json::to_string(&rpc_request(
+            "browser.viewer.grant.issue",
+            json!({"resource_id": f.resource.resource_id, "permissions": ["frames"]}),
+        ))
+        .unwrap();
+        let dispatch = dispatch_for_connection(
+            &text,
+            &chain,
+            &kick.connections,
+            "race-conn",
+            false,
+            "browser.viewer.grant.issue",
+            Some(json!(1)),
+            &start,
+        );
+        let deactivate = async {
+            hooks.entered.notified().await;
+            // Repeat the completed operation: retries must still sweep and
+            // must not reopen admission for a request holding an old snapshot.
+            for _ in 0..2 {
+                let result = handle_update(
+                    rpc_request(
+                        "users.update",
+                        json!({"user_id": USER, "status": "deactivated"}),
+                    ),
+                    store.clone(),
+                    kick.clone(),
+                )
+                .await;
+                assert!(result.error.is_none(), "{:?}", result.error);
+            }
+            assert!(f.grants.grant_info(&earlier.grant_id).is_none());
+            assert_eq!(f.grants.revoke_for_principal(&principal), 0);
+            assert_eq!(
+                kick.connections.read().await["race-conn"].caller_role,
+                "guest"
+            );
+            hooks.release.notify_one();
+        };
+        let (response, ()) = tokio::time::timeout(Duration::from_secs(10), async {
+            tokio::join!(dispatch, deactivate)
+        })
+        .await
+        .expect("barrier interleaving must complete");
+        let response: JsonRpcResponse = serde_json::from_str(&response).unwrap();
+        assert_eq!(response.error.unwrap().message, "denied");
+        assert!(response.result.is_none(), "no launch URL may escape");
+        assert_eq!(
+            f.grants.revoke_for_principal(&principal),
+            0,
+            "no late grant inserted"
+        );
+        assert!(
+            f.state.issue(USER, req()).is_err(),
+            "fresh stale-identity requests also deny"
+        );
+
+        let result = handle_update(
+            rpc_request("users.update", json!({"user_id": USER, "status": "active"})),
+            store.clone(),
+            kick,
+        )
+        .await;
+        assert!(result.error.is_none());
+        let new_grant = f
+            .state
+            .issue(USER, req())
+            .expect("reactivation admits a new grant");
+        assert!(f.grants.grant_info(&new_grant.grant_id).is_some());
+        assert!(
+            f.grants.grant_info(&earlier.grant_id).is_none(),
+            "no resurrection"
+        );
+    }
