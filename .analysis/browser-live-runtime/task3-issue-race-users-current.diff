+
+/// Opaque, cheaply clonable slot for the browser live [`ViewerGrantStore`].
+/// The users handler is built before the browser live runtime is installed,
+/// so the gateway owns one slot, hands clones to the deactivation kick, and
+/// binds the runtime's store into it at install time. A re-install replaces
+/// the bound store, matching `set_browser_viewer_backend`, so the issuer RPCs
+/// and deactivation never act on different stores.
+///
+/// [`ViewerGrantStore`]: crate::browser::live::grant::ViewerGrantStore
+#[derive(Clone, Default)]
+pub struct BrowserViewerGrantRevocation {
+    slot: Arc<std::sync::RwLock<Option<crate::browser::live::grant::ViewerGrantStore>>>,
+}
+
+impl BrowserViewerGrantRevocation {
+    /// Bind the runtime store and its live user authority before exposure.
+    pub(crate) fn bind(
+        &self,
+        grants: crate::browser::live::grant::ViewerGrantStore,
+        users: Option<Arc<SecurityStore>>,
+    ) {
+        grants.set_principal_validator(Arc::new(move |principal| {
+            let aleph_protocol::browser_live::IssuerIdentity::User { user_id } = principal else {
+                return false;
+            };
+            // Lock order: grants -> users. update_user releases the SQL lock
+            // before revoke_user takes the grant lock. Thus an active read
+            // either inserts before that sweep, or observes deactivation and
+            // denies. Missing authority/row and read errors fail closed.
+            users.as_ref().is_some_and(|users| {
+                matches!(users.get_user(user_id), Ok(Some(user)) if user.status == UserStatus::Active)
+            })
+        }));
+        *self
+            .slot
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(grants);
+    }
+
+    /// Whole-grant revoke of every viewer grant `user_id` issued or is bound
+    /// to. Returns how many grants were revoked; 0 when no runtime is bound.
+    pub(crate) fn revoke_user(&self, user_id: &str) -> usize {
+        let Some(grants) = self
+            .slot
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone()
+        else {
+            return 0;
+        };
+        grants.revoke_for_principal(&aleph_protocol::browser_live::IssuerIdentity::User {
+            user_id: user_id.to_string(),
+        })
+    }
