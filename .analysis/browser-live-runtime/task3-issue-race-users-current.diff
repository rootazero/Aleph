+    /// Issuer death: `users.update` deactivation runs the canonical
+    /// whole-grant revoke over the browser live grant store bound into the
+    /// kick; a promotion (role restamp) leaves viewer grants alone, and the
+    /// other user's grant survives either way.
+    #[tokio::test]
+    async fn deactivation_revokes_the_users_browser_viewer_grants_only() {
+        use crate::browser::live::grant::ViewerGrantStore;
+        use aleph_protocol::browser_live::{
+            BrowserTargetBinding, ConversationBinding, IssuerIdentity, ViewerBinding, ViewerOrigin,
+            ViewerPermission,
+        };
