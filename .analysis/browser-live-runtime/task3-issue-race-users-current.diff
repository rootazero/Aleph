+            .create_user("u-alice", "Alice", UserRole::Member)
+            .unwrap();
+        store.create_user("u-bob", "Bob", UserRole::Member).unwrap();
+        let grants = ViewerGrantStore::default();
+        let issue = |user: &str| {
+            let principal = IssuerIdentity::User {
+                user_id: user.to_string(),
+            };
+            grants
+                .issue(
+                    principal.clone(),
+                    ViewerBinding {
+                        principal,
+                        task: ConversationBinding {
+                            session_key: "agent:main:demo".into(),
+                            run_id: "run-1".into(),
+                        },
+                        target: BrowserTargetBinding {
+                            profile: "default".into(),
+                            browser_session_id: "bs-1".into(),
+                            target_id: format!("t-{user}"),
+                        },
+                    },
+                    &format!("res-{user}"),
+                    &[ViewerPermission::Frames],
+                    ViewerOrigin {
+                        scheme: "http".into(),
+                        host: "127.0.0.1".into(),
+                        port: 8787,
+                    },
+                    std::time::Duration::from_secs(600),
+                )
+                .expect("issue")
+                .grant_id
+        };
+        let alice = issue("u-alice");
+        let bob = issue("u-bob");
+        let kick = test_kick_sink();
+        kick.browser_viewer_grants
+            .bind(grants.clone(), Some(store.clone()));
+
+        handle_update(
+            rpc_request(
+                "users.update",
+                json!({"user_id": "u-alice", "role": "admin"}),
+            ),
+            store.clone(),
+            kick.clone(),
+        )
+        .await;
+        assert!(
+            grants.grant_info(&alice).is_some(),
+            "a role restamp is not issuer death"
+        );
+
+        handle_update(
+            rpc_request(
+                "users.update",
+                json!({"user_id": "u-alice", "status": "deactivated"}),
+            ),
+            store.clone(),
+            kick,
+        )
+        .await;
+        assert!(grants.grant_info(&alice).is_none(), "alice's grant revoked");
+        assert!(grants.grant_info(&bob).is_some(), "bob's grant untouched");
+    }
