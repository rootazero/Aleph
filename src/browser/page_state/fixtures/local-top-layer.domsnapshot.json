    "outside every container",
    "SCRIPT",
    "\n    // `?open=` selects what to open; the fullscreen arm needs a user gesture and so\n    // is driven from the probe rather than from load.\n    var q = new URL(location.href).searchParams;\n    var want = q.get('open') ?? 'all';\n    window.__opened = [];\n    function tryOpen(fn, label) {\n      try { fn(); window.__opened.push(label); }\n      catch (e) { window.__opened.push(label + ': THREW ' + String(e && e.name)); }\n    }\n    if (want !== 'none') {\n      tryOpen(function () { document.getElementById('tl-dlg').showModal(); }, 'tl-dlg.showModal');\n      tryOpen(function () { document.getElementById('tl-pop').showPopover(); }, 'tl-pop.showPopover');\n      // `.show()` is NOT `.showModal()`: an open non-modal dialog never enters the\n      // top layer at all, which is why it is a negative and not a gap.\n      tryOpen(function () { document.getElementById('neg-nonmodal').show(); }, 'neg-nonmodal.show');\n    }\n    window.__goFullscreen = function () {\n      return document.getElementById('tl-fs').requestFullscreen()\n        .then(function () { return 'ok'; })\n        .catch(function (e) { return 'REJECTED: ' + String(e && e.name); });\n    };\n  ",
    "\n\n\n"
  ]
}
