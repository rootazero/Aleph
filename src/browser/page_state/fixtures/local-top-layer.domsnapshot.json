    "\n  html,body { margin:0; padding:0; background:#fff;\n              font:16px/1.4 -apple-system, Helvetica, Arial, sans-serif; }\n  /* The ONE container. Everything under test is a descendant of it, so a node's\n     verdict is never about which container it sits in — only about whether it\n     leaves the paint group. */\n  #fade        { opacity:0; }\n  dialog       { margin:0; padding:0; border:0; background:#f00; }\n  #neg-fixed   { position:fixed; left:10px; top:120px; background:#0a0; }\n  #tl-pop      { margin:0; padding:0; border:0; background:#00f; }\n  #tl-fs       { background:#ff0; }\n  button       { cursor:pointer; }\n",
