{
  "name": "control_plane",
  "version": "1.0.0",
  "description": "Aleph Control Plane UI",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i styles/tailwind.css -o dist/tailwind.css --minify",
    "panel:spike:build": "bun scripts/build-panel-spike.ts",
    "panel:spike:report": "bun scripts/panel-spike-report.ts",
    "panel:spike:test": "bun x --no-install playwright test --config .panel-spike/playwright.config.ts",
    "panel:spike:serve": "bun scripts/build-panel-spike.ts --serve",
    "panel:tabs:build": "bun scripts/build-panel-tabs.mjs",
    "panel:tabs:report": "bun scripts/panel-tabs-report.mjs",
    "panel:tabs:test": "node --test tests/panel-build.test.mjs",
    "panel:tabs:protocol:test": "node tests/panel-terminal-protocol.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "tailwindcss": "^4.2",
    "@tailwindcss/cli": "^4.2"
  }
}
